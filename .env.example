# copy this file to .env and fill in your real values.
# .env is git-ignored -- .env.example is NOT (it's safe to commit since
# it has no real secrets in it, just shows what's needed)

# local mysql -- used by the backend AND the import scripts
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=game_tracker

# only on railway / hosting: a full connection string. if this is set
# the backend uses it instead of the DB_ values above
# format: mysql://user:password@host:port/dbname
DATABASE_URL=

# generate strong random strings with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-flask-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
