# Copy to .env for local development (never commit .env)

# Railway MySQL plugin provides this automatically in production.
# For local dev, either use SQLite (leave blank) or point at your DB.
DATABASE_URL=

# Generate strong random strings for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-flask-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
